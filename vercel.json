{
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/build",
  "installCommand": "npm install && npm --prefix frontend install && npm --prefix backend install",
  "functions": {
    "api/[[...path]].js": {
      "includeFiles": "backend/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[[...path]].js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
